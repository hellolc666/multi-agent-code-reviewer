# LLM provider — "anthropic" (default), "openai", or "qwen"
LLM_PROVIDER=anthropic

# Per-provider API keys. Only the one matching LLM_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Qwen: all three are required when LLM_PROVIDER=qwen. Copy values from your
# DashScope workspace OpenAI-compatible base URL (not /apps/anthropic).
# Keep your region/workspace host; the SDK base path is usually /compatible-mode/v1.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=

# Additional invalid-output repair requests (0..2); never retries auth failures.
REVIEWER_JSON_REPAIR_RETRIES=2
REVIEWER_PLANNER_MODE=rules
REVIEWER_JUDGE_ENABLED=true
REVIEWER_CORRECTNESS_TIMEOUT_S=90

# Optional model override. When unset, the provider-default is used:
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-5.5
LLM_MODEL=

# GitHub — required for private repos and for posting PR comments.
GITHUB_TOKEN=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-code-reviewer
