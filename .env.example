# LLM provider — "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Per-provider API keys. Only the one matching LLM_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override. When unset, the provider-default is used:
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-5.5
LLM_MODEL=

# GitHub — required for private repos and for posting PR comments.
GITHUB_TOKEN=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-code-reviewer
